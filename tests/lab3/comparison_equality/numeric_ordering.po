// Numeric ordering returns booleans and distinguishes strict and inclusive boundaries.
3 > 2; // expect: true
2 > 2; // expect: false
2 >= 2; // expect: true
1 >= 2; // expect: false
1 < 2; // expect: true
2 < 2; // expect: false
2 <= 2; // expect: true
3 <= 2; // expect: false
-2 < -1; // expect: true
2.5 >= 2.4; // expect: true
1 + 2 > 2 * 1; // expect: true
